# Copia este archivo a .env y completa los valores reales. .env no se versiona.

# Base de datos MySQL
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=registro_proyecto

# Contraseña de /registros.php (vacío = usa la de por defecto)
ADMIN_PASSWORD=

# Correo SMTP (para Gmail usa una contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
